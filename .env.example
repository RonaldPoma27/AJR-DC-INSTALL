# Copiá este archivo a `.env` y completá los valores antes de `docker compose up --build`.

# --- Base de datos ---
POSTGRES_DB=ajr
POSTGRES_USER=ajr
POSTGRES_PASSWORD=cambiar-esta-clave

# --- Django ---
DJANGO_SECRET_KEY=generar-una-clave-larga-y-aleatoria
DJANGO_DEBUG=0
# Dominio(s) público(s), separados por coma.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Origen(es) con esquema, necesarios para el /django-admin/ detrás de HTTPS. Ej: https://matafuegos.ajrdata.com
DJANGO_CSRF_TRUSTED_ORIGINS=
# Poné 1 cuando sirvas todo por HTTPS.
DJANGO_SECURE_COOKIES=0

# --- URL pública del sitio (es lo que codifican los QR y los links de los emails) ---
PUBLIC_BASE_URL=http://localhost:8080
FRONTEND_PORT=8080

# --- Único usuario ADMIN (se crea al arrancar si todavía no existe) ---
ADMIN_EMAIL=admin@ajrdata.com
ADMIN_PASSWORD=Cambiar-Esta-Clave1!
ADMIN_FULL_NAME=Administrador AJR

# --- Semáforo ---
FIRE_WARNING_DAYS=30

# --- Email (avisos de chat) ---
# Desarrollo: salen por la consola del contenedor `backend`.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# Producción (SMTP): descomentá y completá.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.tu-proveedor.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=1
# DEFAULT_FROM_EMAIL=AJR Data <no-reply@ajrdata.com>
